# ============================================================
# Mercado Nube - plantilla de configuracion local (SIN secretos)
#
# No copies este archivo a mano: ejecuta .\scripts\run_demo.ps1 y el
# script crea .env con claves aleatorias en los campos vacios marcados
# como [se genera]. .env esta en .gitignore y NUNCA se versiona.
# En AWS estos valores vienen de Secrets Manager / SSM, no de archivos.
# ============================================================

# Proyecto Docker (evita mezclarse con otros proyectos)
COMPOSE_PROJECT_NAME=mercado-nube

# PostgreSQL local
POSTGRES_ADMIN_USER=mn_admin
# [se genera]
POSTGRES_ADMIN_PASSWORD=
# [se genera]
AIRFLOW_DB_PASSWORD=
# [se genera]
WAREHOUSE_PASSWORD=

# S3 local con Moto (credenciales dummy test/test definidas en docker-compose;
# Moto no valida IAM y no son credenciales reales de AWS)
S3_API_HOST_PORT=9002

# Usuario administrador de la UI de Airflow
AIRFLOW_ADMIN_USER=admin
# [se genera]
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Claves internas de Airflow
# [se genera] Fernet key para cifrar conexiones/variables de Airflow
AIRFLOW_FERNET_KEY=
# [se genera]
AIRFLOW_SECRET_KEY=

# Puertos en el host (cambialos si estan ocupados)
AIRFLOW_HOST_PORT=8088
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8001
ADMINER_HOST_PORT=8082

# Configuracion no secreta
WAREHOUSE_DB=mercado_nube
AIRFLOW_DB=airflow
S3_BUCKET=mercado-nube
S3_REGION=us-east-1
REPORTING_CURRENCY=USD
QUALITY_MAX_REJECTION_RATE=0.10
QUALITY_MAX_DUPLICATE_RATE=0.05
QUALITY_MAX_UNKNOWN_RATE=0.05
QUALITY_FRESHNESS_HOURS=24

# Politica de reintentos de Airflow (backoff exponencial)
PIPELINE_RETRIES=2
PIPELINE_RETRY_DELAY_SECONDS=30
PIPELINE_MAX_RETRY_DELAY_MINUTES=10

# Schedule del DAG diario. Vacio = solo disparo manual/backfill (modo demo).
# En un ambiente real: DAILY_SCHEDULE=@daily (el DAG usa la fecha logica ds).
DAILY_SCHEDULE=
