# ============================================================
# Mercado Nube - variables locales de demostracion
# Copia este archivo a .env y cambia los valores.
# NUNCA versiones .env ni uses estas claves en produccion.
# ============================================================

# Proyecto Docker (evita mezclarse con otros proyectos)
COMPOSE_PROJECT_NAME=mercado-nube

# PostgreSQL local
POSTGRES_ADMIN_USER=mn_admin
POSTGRES_ADMIN_PASSWORD=cambia_esta_clave
AIRFLOW_DB_PASSWORD=cambia_esta_clave
WAREHOUSE_PASSWORD=cambia_esta_clave

# S3 local con Moto (credenciales dummy: test/test; Moto no valida IAM)
S3_API_HOST_PORT=9002

# Airflow (credenciales DEMO locales; cambialas si expones el puerto)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin123
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Genera valores propios con:
# python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Clave DEMO de ejemplo; NO usar en produccion.
AIRFLOW_FERNET_KEY=nyTSolzcukS3XkjjX0bTqrrP_pbQ4OSelS66TfaY9dM=
AIRFLOW_SECRET_KEY=cambia_este_secreto_local

# Puertos en el host (cambialos si estan ocupados)
AIRFLOW_HOST_PORT=8088
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8001
ADMINER_HOST_PORT=8082

# Configuracion no secreta
WAREHOUSE_DB=mercado_nube
AIRFLOW_DB=airflow
S3_BUCKET=mercado-nube
S3_REGION=us-east-1
REPORTING_CURRENCY=USD
QUALITY_MAX_REJECTION_RATE=0.10
QUALITY_MAX_DUPLICATE_RATE=0.05
QUALITY_MAX_UNKNOWN_RATE=0.05
QUALITY_FRESHNESS_HOURS=24

# Politica de reintentos de Airflow (backoff exponencial)
PIPELINE_RETRIES=2
PIPELINE_RETRY_DELAY_SECONDS=30
PIPELINE_MAX_RETRY_DELAY_MINUTES=10

# Schedule cron opcional para el DAG diario; vacio = solo disparo manual.
DAILY_SCHEDULE=

